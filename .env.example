# Скопируйте в .env и заполните локально. Не отправляйте токены в чат агенту.

# Обязательные для live Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Настройки приложения.
APP_TIMEZONE=Europe/Berlin
SOURCE_CONFIG_PATH=config/sources.json
DATA_ROOT=data-sources
STATE_DB_PATH=data/bot.db

# Codex CLI использует локальную авторизацию подписки.
CODEX_BIN=codex
# Не задавайте модель без необходимости: по умолчанию используется default Codex CLI.
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=60000
MAX_BRAIN_QUEUE=8

# Безопасные defaults.
ALLOW_GROUPS=0
ALLOW_WRITES=0
LOG_CONTENT=0
CONTEXT_TTL_MINUTES=15
CONTEXT_TURN_LIMIT=6
